# Copy to .env.local (apps/web) or .env (apps/api). Never commit real values.

# masterfabric-go (apps/api)
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
JWT_SECRET=change-me-in-production
CORS_ALLOWED_ORIGINS=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=talerole
DB_PASSWORD=change-me
DB_NAME=talerole
DB_SSLMODE=disable
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=talerole

# Next.js — only NEXT_PUBLIC_* is visible in the browser. No secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DEFAULT_LOCALE=en

# LLM gateway (later) — keys stay in the secret store, not git
# LLM_STORYTELLER_URL=
# LLM_MECHANICS_URL=
