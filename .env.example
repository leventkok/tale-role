# Copy to .env.local (apps/web) or .env (apps/api). Never commit real values.

# masterfabric-go (apps/api)
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
JWT_SECRET=change-me-in-production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=talerole
DB_PASSWORD=change-me
DB_NAME=talerole
DB_SSLMODE=disable
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=talerole

# Next.js server-only (never NEXT_PUBLIC — the browser talks to Next, not Go)
API_URL=http://127.0.0.1:8080

# Next.js — only NEXT_PUBLIC_* is visible in the browser. No secrets here.
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Local only — never set in production. Lets you type a known 6-digit OTP without mail.
# TALEROLE_DEV_OTP=123456

# Optional: this email joins rooms as an invisible system_admin spectator.
# TALEROLE_ADMIN_EMAIL=admin@tale.role

# LLM gateway (F3). The API embeds a stub adapter in-process; this token is for the standalone process.
# LLM_GATEWAY_ADMIN_TOKEN=change-me
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8090

# LLM gateway (F3). The API embeds a stub adapter in-process; this token is for the standalone process.
# LLM_GATEWAY_ADMIN_TOKEN=change-me
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8090

# Production: OUR private Hugging Face repos (weight store). Not a paid Inference API.
# HF_TOKEN belongs only on the GPU runner secret manager — never here, never git.
# HF_STORYTELLER_MODEL=your-org/talerole-storyteller
# HF_MECHANICS_MODEL=your-org/talerole-mechanics
# LLM_STORYTELLER_URL=https://storyteller.example.com
# LLM_MECHANICS_URL=https://mechanics.example.com
# LLM_RUNNER_URL=

# Local Mailhog (compose). Production SMTP uses host/port/user/pass from the secret manager.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_FROM=Tale Role <noreply@talerole.local>
# SMTP_USER=
# SMTP_PASS=
