{
  "name": "tale-role",
  "private": true,
  "description": "Tale Role — AI-hosted FRP table",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/i18n",
    "packages/game-schema",
    "apps/web",
    "apps/admin"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "eval": "npm run eval -w @tale-role/game-schema",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev -w @tale-role/web",
    "dev:admin": "npm run dev -w @tale-role/admin",
    "dev:desktop": "npm start --prefix apps/desktop",
    "pack:desktop": "npm run pack --prefix apps/desktop"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
